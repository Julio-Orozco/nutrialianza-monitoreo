    {
      "parameters": {
        "jsCode": "const results = $json.data?.result || [];\n \nlet mensajeMetricas = \"\";\n \nif (results.length === 0) {\n  mensajeMetricas = \"No se recibieron métricas desde Prometheus.\";\n} else {\n  mensajeMetricas = results.map(item => {\n    const job = item.metric?.job || \"servicio desconocido\";\n    const instance = item.metric?.instance || \"instancia desconocida\";\n    const value = item.value?.[1] || \"sin valor\";\n    return `Servicio: ${job} | Instancia: ${instance} | Estado: ${value}`;\n  }).join(\"\\n\");\n}\n \nreturn [\n  {\n    json: {\n      metricas: mensajeMetricas,\n      prompt: `Actúa como analista de infraestructura de NutriAlianza S.A.\n \nPrometheus devolvió el siguiente estado de servicios:\n \n${mensajeMetricas}\n \nGenera una alerta breve para el equipo de TI con:\n1. Estado general del sistema\n2. Posible interpretación técnica\n3. Recomendación inicial\n \nResponde en español, de forma clara y profesional.`\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        144,
        0
      ],
      "id": "7599938a-98d6-4767-ae9e-30bbce9ed612",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.GROQ_API_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"llama-3.1-8b-instant\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Genera una alerta breve para NutriAlianza S.A. indicando que Prometheus detectó servicios activos.\"\n    }\n  ],\n  \"temperature\": 0.2\n}",
        "options": {}
      },
