      "name": "Consultar Prometheus"
    },
    {
      "parameters": {
        "jsCode": "const results = $json.data?.result || [];\n \nif (results.length === 0) {\n  return [];\n}\n \nconst nginxUp = parseFloat(\n  results[0].value?.[1] || \"0\"\n);\n \n// Nginx está funcionando: no generar alerta\nif (nginxUp > 0) {\n  return [];\n}\n \nconst prompt = `\nActúa como analista de infraestructura de NutriAlianza S.A.\n \nPrometheus detectó que el servidor web Nginx dejó de estar disponible.\n \nDATOS DEL INCIDENTE:\n- Servicio afectado: Nginx\n- Tipo de incidente: Caída del servicio web\n- Estado detectado por Prometheus: nginx_up = ${nginxUp}\n- Health check esperado: sin respuesta\n- Puerto crítico afectado: 443\n- Disponibilidad esperada durante el incidente: servicio web fuera de línea\n \nGenera una alerta técnica breve para el equipo de TI indicando:\n \n1. Severidad\n2. Qué está ocurriendo\n3. Causa probable\n4. Impacto sobre los usuarios y aplicaciones\n5. Recomendación técnica inmediata\n \nResponde en español, de manera clara y profesional.\n`;\n \nreturn [\n  {\n    json: {\n      tipoIncidente: \"Caída del servicio web Nginx\",\n      nginxUp,\n      puertoAfectado: 443,\n      prompt\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        368,
        0
      ],
      "id": "f15218c1-38c4-4d3b-ba92-305834187963",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.GROQ_API_KEY}}"
            },
