      "name": "Consultar Prometheus"
    },
    {
      "parameters": {
        "jsCode": "const results = $json.data?.result || [];\n \nif (results.length === 0) {\n  return [];\n}\n \nconst requestsPerSecond = parseFloat(\n  results[0].value?.[1] || \"0\"\n);\n \nconst UMBRAL_RPS = 20;\n \n// Si el tráfico está normal, no generar alerta\nif (requestsPerSecond < UMBRAL_RPS) {\n  return [];\n}\n \nconst prompt = `\nActúa como analista de infraestructura de NutriAlianza S.A.\n \nPrometheus detectó tráfico HTTP anormal sobre el servidor Nginx.\n \nDATOS DEL INCIDENTE:\n- Servicio: Nginx\n- Tipo de incidente: Saturación HTTP\n- Solicitudes por segundo detectadas: ${requestsPerSecond.toFixed(2)}\n- Umbral configurado: ${UMBRAL_RPS} solicitudes por segundo\n- Endpoint sometido a prueba: /stress\n \nDurante esta situación Nginx puede comenzar a rechazar solicitudes con código HTTP 503.\n \nGenera una alerta técnica breve para el equipo de TI indicando:\n \n1. Severidad\n2. Qué está ocurriendo\n3. Causa probable\n4. Impacto posible\n5. Recomendación técnica inmediata\n \nResponde en español, de manera clara y profesional.\n`;\n \nreturn [\n  {\n    json: {\n      tipoIncidente: \"Saturación HTTP Nginx\",\n      requestsPerSecond,\n      umbral: UMBRAL_RPS,\n      prompt\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        368,
        0
      ],
      "id": "efacf78e-aacb-41bb-84e8-c369010df44f",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.GROQ_API_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"llama-3.1-8b-instant\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": {{$json.prompt.toJsonString()}}\n    }\n  ],\n  \"temperature\": 0.2\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        528,
